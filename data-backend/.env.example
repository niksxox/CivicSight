# Copy this file to .env and fill in real values.
# Never commit the real .env file.

DATABASE_URL=postgresql+psycopg2://civsight_user:civsight_pass@localhost:5432/civsight
POSTGRES_USER=civsight_user
POSTGRES_PASSWORD=civsight_pass
POSTGRES_DB=civsight
POSTGRES_PORT=5432
API_PORT=8000

# Radius (in meters) used for "nearby population / facilities" queries
NEARBY_RADIUS_METERS=1000

# AI confidence threshold below which citizen evidence is flagged
# "Needs Human Review" instead of being trusted as fact
AI_CONFIDENCE_THRESHOLD=0.65
