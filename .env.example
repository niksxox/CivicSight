# ============================================================
# CivicSight — Root Environment Configuration
# Copy this file to .env and fill in real values.
# ============================================================

# --- Global ---
ENVIRONMENT=production
FRONTEND_URL=http://localhost:3000

# --- MongoDB ---
MONGO_USER=civsight
MONGO_PASSWORD=change-me-mongo-password
MONGO_DB=civsight
MONGO_PORT=27017

# --- PostgreSQL/PostGIS ---
POSTGRES_USER=civsight_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=civsight
POSTGRES_PORT=5433

# --- Node.js API ---
NODE_API_PORT=5000
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- Data Backend ---
DATA_API_PORT=8000
NEARBY_RADIUS_METERS=1000
AI_CONFIDENCE_THRESHOLD=0.65

# --- AI Service ---
AI_API_PORT=8001
GROQ_API_KEY=your-groq-api-key-here

# --- Frontend ---
FRONTEND_PORT=3000
